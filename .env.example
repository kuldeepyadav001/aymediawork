# Application
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, development-only comma-separated preview hostnames
ALLOWED_DEV_ORIGINS=

# Supabase (publishable values are safe for browser use when RLS is enabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only; required by inquiry/newsletter routes and privileged admin operations
SUPABASE_SECRET_KEY=
# Server-only exact email allowed to activate the one-time first owner
ADMIN_BOOTSTRAP_EMAIL=

# Email (server-only)
RESEND_API_KEY=
# Example after domain verification: AY Media Work <inquiries@yourdomain.com>
RESEND_FROM_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=

# Anti-spam and rate limiting
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate independently (for example: openssl rand -hex 32); server-only
SUBMISSION_RATE_LIMIT_SECRET=

# Optional analytics (all providers require an explicit true flag or valid ID,
# and remain gated behind the visitor's analytics consent)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false
NEXT_PUBLIC_VERCEL_SPEED_INSIGHTS_ENABLED=false

# Server-only application secrets
REVALIDATION_SECRET=
